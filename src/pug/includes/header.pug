header.header
    .container
        .row
            svg(width='0' height='0')
                defs
                    clipPath#maskHeader(clipPathUnits='objectBoundingBox')
                        path(d="M 0,1 L 0,0 L 1,0 L 1.1,.7 C -.25 2, -1.4 -2, 0 1 Z")
                        
                        

            .col-6.col-lg-2.header--logo
                a(href="./")
                    img.img-fluid#header--logo(src="../img/logo-anicann.png" ,  alt="Anicann")
                    
                

            .col-6.header--navegacion.d-lg-none
                nav.navbar-expand-lg
                    .btn(data-toggle='collapse' data-target='#navbarNav' aria-controls='navbarNav' aria-expanded='false' aria-label='Toggle navigation')
                        
            .col-12.col-lg-10.d-lg-flex
                div.collapse.navbar-collapse#navbarNav.d-lg-block
                    ul
                        li#menuNoticias(class= noticias)
                            a(href="noticias.html") Noticias
                        
                        li#menuMultimedia(class= multimedia) 
                            a(href="multimedia.html") Multimedia

                        li#menuReporte(class= reporte) 
                            a(href="reporte-verde.html") Reporte Verde
                        
                        li#menuArticulos(class= articulos) 
                            a(href="articulos.html") Artículos

                        li#menuContacto(class= contacto) 
                            a(href="contacto.html") Contacto
                            

                        li#navbarNav--redes
                            a(href="https://www.facebook.com/ANICANNMX/" target="_blank")
                                img(src="../../img/icon-facebook.svg", alt="")
                            
                            a(href="https://www.instagram.com/anicannmx/" target="_blank")
                                img(src="../../img/icon-twitter.svg", alt="")

                            a(href="https://twitter.com/anicannmx" target="_blank")
                                img(src="../../img/icon-instagram.svg", alt="")

