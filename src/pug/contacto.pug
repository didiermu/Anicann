- titulo = "Anicann - Contacto"
- contacto = "menuActivo"

doctype
html(lang='es')

    include includes/head.pug


    body.contacto
        include includes/header.pug

        .mancha#mancha1
            img.img-fluid.mancha1(src="../img/mancha1.svg", alt="")
            img.img-fluid.mancha2(src="../img/mancha2.svg", alt="")
    
        .mancha#mancha2
            img.img-fluid.mancha1(src="../img/mancha1.svg", alt="")
            img.img-fluid.mancha2(src="../img/mancha2.svg", alt="")

        section.contacto--section.sectionFade
            .mancha#mancha3
                img.img-fluid.mancha1(src="../img/mancha1.svg", alt="")
                img.img-fluid.mancha2(src="../img/mancha2.svg", alt="")

            .container 
                .row.justify-content-end.objetFade
                    .col-12.col-lg-7
                        h1 
                            b Contacto

                .row.justify-content-center.objetFade
                    .col-12.col-lg-7.contacto--section--form
                        form#form-contacto
                            .cajaInput
                                input.input#input-name(type="text", name="", placeholder="Nombre")
                            
                            .cajaInput
                                input.input#input-apellido(type="text", name="", placeholder="Apellido")

                            .cajaInput
                                input.input#input-edad(type="text", name="", placeholder="Edad")
                            
                            .cajaInput
                                input.input#input-email(type="text", name="", placeholder="Email")
                            
                            .cajaInput
                                textarea.input#input-comentarios(placeholder="Comentarios")

                            input.boton.boton-on#boton-enviar-contacto(type="button", value="Enviar")


                    .col-12.col-lg-5.contacto--section--back
                        img.img-fluid.d-none.d-lg-block(src="../img/back-contacto2.jpg", alt="")

                
                    .col-12.col-lg-11.contacto--section--organigrama
                        h3.d-none.d-lg-block(data-toggle="modal" data-target="#modal-organigrama") Conoce el organigrama
                        img.img-fluid.d-lg-none(src="../img/organigrama.jpg", alt="")


        .modal.fade#modal-organigrama(tabindex='-1' role='dialog')
            .modal-dialog.modal-dialog-centered.modal-md(role='document')
                .modal-content
                    .modal-header
                        button.close(type='button' data-dismiss='modal' aria-label='Close')
                            img(src="../img/icon-closes-green.svg", alt="",aria-hidden='true')

                    .modal-body
                        .row.justify-content-center
                            .col-12
                                img.img-fluid(src="../img/organigrama.jpg", alt="")

        .modal.fade#modal-thankyou(tabindex='-1' role='dialog')
            .modal-dialog.modal-dialog-centered.modal-xl(role='document')
                .modal-content
                    .modal-header
                        button.close(type='button' data-dismiss='modal' aria-label='Close')
                            img(src="../img/icon-closes-green.svg", alt="",aria-hidden='true')

                    .modal-body
                        .row.justify-content-center
                            .col-12.col-lg-10
                                h3 
                                    b ¡Gracias!
                                h5 En breve recibirás más noticias de nosotros

                        .mancha
                            img.img-fluid.mancha1(src="../img/mancha1.svg", alt="")
                            img.img-fluid.mancha2(src="../img/mancha2.svg", alt="")
                            
        include includes/footer.pug