- titulo = "Anicann - Multimedia"
- reporte = "menuActivo"

doctype
html(lang='es')

    include includes/head.pug


    body.multimedia.reporte
        include includes/header.pug

        section.multimedia--hero

            .container 
                .row
                    .col-12.col-lg-7
                        svg(width='0' height='0')
                            defs
                                clipPath#myCurve(clipPathUnits='objectBoundingBox')
                                    path(d="M 0,1 L 0,0 L 1,0 L 3,3 C .1 0, 1.2 1.1, 0 1, 0 0 Z")
                        
                        .multimedia--hero--copy
                            h1 REPORTE VERDE
                            h5 Mantente informado con las últimas noticias acerca del uso de la cannabis

        
        section.multimedia--carrusel
            .container
                
                .row.justify-content-center
