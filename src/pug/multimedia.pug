- titulo = "Anicann - Multimedia"
- multimedia = "menuActivo"

doctype
html(lang='es')

    include includes/head.pug


    body.multimedia
        include includes/header.pug

        section.multimedia--hero.sectionFade(style="background: url('img/hero.jpg') no-repeat center / cover fixed;")

            .container 
                .row
                    .col-12.col-lg-7
                        svg(width='0' height='0')
                            defs
                                clipPath#myCurve(clipPathUnits='objectBoundingBox')
                                    path(d="M 0,1 L 0,0 L 1,0 L 1,0 C 1.3 1.8, .4 .5, 0 1 Z")
                        
                        .multimedia--hero--copy.objetFade
                            h1 ANICANN MULTIMEDIA
                            h5 Entrevistas, testimonios y videos informativos acerca de la industria del cannabis.

        
        section.multimedia--carrusel.sectionFade
            .container
                
                .row.justify-content-center
                    .col-12.multimedia--carrusel--videos.objetFade
                        .mancha#mancha1
                            img.img-fluid.mancha2(src="../img/mancha1.svg", alt="")
                        
                        .mancha#mancha2
                            img.img-fluid.mancha2(src="../img/mancha1.svg", alt="")

                        .owl-carousel.owl-theme#carrusel-videos

                            .multimedia--carrusel__video.videos-guillermo
                               
                                iframe(src='https://www.youtube.com/embed/Mh4f9AYRCZY' frameborder='0' allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture' allowfullscreen)

                                h4
                                    b Caso Aymeé Elizabeth

                            .multimedia--carrusel__video.videos-guillermo
                               
                                iframe(src='https://www.youtube.com/embed/Mh4f9AYRCZY' frameborder='0' allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture' allowfullscreen)

                                h4
                                    b Caso Aymeé Elizabeth

                            .multimedia--carrusel__video.video-categoria-educacion
                                
                                iframe(src='https://www.youtube.com/embed/Mh4f9AYRCZY' frameborder='0' allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture' allowfullscreen)
                                
                                h4
                                    b Caso Aymeé Elizabeth

                            .multimedia--carrusel__video.video-categoria-testimonios
                                iframe(src='https://www.youtube.com/embed/Mh4f9AYRCZY' frameborder='0' allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture' allowfullscreen)
                                
                                
                                h4
                                    b Caso Aymeé Elizabeth
                            
                            .multimedia--carrusel__video.video-categoria-noticias
                                iframe(src='https://www.youtube.com/embed/Mh4f9AYRCZY' frameborder='0' allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture' allowfullscreen)
                                
                                
                                h4
                                    b Caso Aymeé Elizabeth
                                    

                    .col-12.col-lg-5.multimedia--carrusel--filtros
                        .multimedia--carrusel--filtros__item#filtro-guillermo
                            h5 Guillermo Nieto 
                            img(src="../img/cat-1.svg")

                        .multimedia--carrusel--filtros__item#filtro-educacion
                            h5 Educación cannábica
                            img(src="../img/cat-2.svg")

                        .multimedia--carrusel--filtros__item#filtro-testimonios
                            h5 Testimonios
                            img(src="../img/cat-3.svg")

                        .multimedia--carrusel--filtros__item#filtro-noticias
                            h5 Noticias
                            img(src="../img/cat-4.svg")
        
        include includes/footer.pug